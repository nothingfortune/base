#!/usr/bin/env bash
# Pre-push gate: run the local suite so a red branch can't be pushed — a
# broken push burns a CI run and (on ready PRs) a bot review for nothing.
# Wired automatically by npm install (postinstall sets core.hooksPath).
# Emergency bypass: git push --no-verify — you own what happens next.
#
# The gate validates the CURRENT CHECKOUT (HEAD). Pushing a ref that isn't
# HEAD (git push origin other-branch) can't be validated from here, so it
# is allowed through with a warning rather than green-lit by the wrong tree.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

head="$(git rev-parse HEAD)"
zero="0000000000000000000000000000000000000000"
gated=0
unvalidated=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # ref deletion — nothing to validate
  if [ "$local_sha" = "$head" ]; then
    gated=1
  else
    # Warn PER REF: in a multi-ref push the HEAD match must not silently
    # green-light the refs the gate cannot see.
    echo "pre-push: cannot validate $local_ref — not the current checkout (CI still covers it)." >&2
    unvalidated=1
  fi
done

if [ "$gated" -eq 0 ]; then
  [ "$unvalidated" -eq 1 ] && echo "pre-push: nothing pushed matches the current checkout — skipping the local gate." >&2
  exit 0
fi

# The gate runs against the working tree, which is only a proxy for the
# pushed commit when tracked files have drifted from HEAD. Surface that
# drift loudly: uncommitted fixes would green-light a red commit (and
# usually mean a forgotten `git commit`), while unrelated edits can block
# a valid one. Either way the verdict below is about the TREE — CI on the
# pushed commit stays the authority.
drift="$(git status --porcelain --untracked-files=no)"
if [ -n "$drift" ]; then
  {
    echo "pre-push: WARNING — working tree differs from the commit being pushed:"
    echo "$drift" | sed 's/^/pre-push:   /'
    echo "pre-push: the gate validates the tree, not the commit. Forgot to commit?"
    echo "pre-push: (--no-verify skips the gate if these edits wrongly block you)"
  } >&2
fi

echo "pre-push: npm run check (bypass with --no-verify)" >&2
npm run check
