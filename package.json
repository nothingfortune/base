{
  "name": "base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:drift": "node scripts/check-coverage-drift.mjs",
    "comment-density": "bash bin/comment-density.sh",
    "docs:check": "node scripts/check-docs.mjs",
    "tokens": "node scripts/design-tokens.mjs",
    "design:check": "node scripts/design-tokens.mjs --check",
    "integrity": "integrity check",
    "check": "npm run typecheck && npm run lint && npm run comment-density && npm run integrity && npm run format:check && npm run test:coverage && npm run coverage:drift && npm run test:bin && npm run lint:fail-open && npm run test:defects && npm run test:git-isolation && npm run docs:check && npm run design:check",
    "test:bin": "bash tests/bin/run.sh",
    "lint:fail-open": "bash bin/fail-open-lint.sh",
    "test:defects": "bash bin/planted-defects.sh",
    "test:git-isolation": "bash bin/git-isolation-check.sh",
    "postinstall": "git config core.hooksPath >/dev/null 2>&1 || git config core.hooksPath .githooks || true",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nothingfortune/workflows": "github:nothingfortune/workflows#125089c3642893f0995161f7eaf16b45df8cf05b",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  }
}
