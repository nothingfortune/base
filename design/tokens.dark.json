{
  "$description": "Dark-theme overrides for semantic tokens; types come from tokens.json.",
  "color": {
    "accent": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3765, 0.6471, 0.9804],
          "hex": "#60a5fa"
        }
      },
      "fg": {
        "$value": "{color.neutral.900}"
      }
    },
    "bg": {
      "surface": {
        "$value": "{color.neutral.900}"
      },
      "raised": {
        "$value": "{color.neutral.800}"
      }
    },
    "fg": {
      "default": {
        "$value": "{color.neutral.50}"
      },
      "muted": {
        "$value": "{color.neutral.400}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.700}"
      }
    }
  }
}
